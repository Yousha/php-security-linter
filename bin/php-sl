#!/usr/bin/env php
<?php

/**
 * Console script for PHP Security Linter.
 *
 * @package PhpSecurityLinter
 */

error_reporting(E_ALL);
ini_set('display_errors', '1');
ini_set('display_startup_errors', '1');

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "Error: This script can only be run from terminal.\n");
    exit(1);
}

$autoloadPath = $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoloadPath)) {
    $autoloadPath = dirname(__DIR__, 3) . '/autoload.php';
}

if (!file_exists($autoloadPath)) {
    fwrite(STDERR, "Error: Vendor autoload file not found. Run 'composer install'.\n");
    exit(3);
}

require_once $autoloadPath;

use Yousha\PhpSecurityLinter\Linter;
use Yousha\PhpSecurityLinter\Exceptions\LinterException;

/**
 * Displays command line help information for PHP Security Linter.
 */
function showHelp(): void
{
    echo <<<HELP
PHP Security Linter - 2.0.2.4
Usage: php vendor/bin/php-sl [options]

Options:
  -p, --path=PATH      Directory or single .php file to scan (required)
  --exclude=LIST       Comma-separated exclusions (dirs/files)
  --help               Show this help message

Examples:
  php vendor/bin/php-sl --path=./src
  php vendor/bin/php-sl -p ./app --exclude=vendor,tests
  php vendor/bin/php-sl --path=./src/Controller.php

HELP;
}

/**
 * Outputs security scan results.
 */
function outputResults(array $results): void
{
    $scannedCount = $results['_meta']['scanned_count'] ?? 0;
    $issueCount = $results['_meta']['issue_count'] ?? 0;
    unset($results['_meta']);

    echo "Scan results\n";
    echo str_repeat("=", 40) . "\n\n";

    foreach ($results as $file => $issues) {
        echo "File: {$file}\n";
        foreach ($issues as $issue) {
            echo sprintf(
                "  \u2717 [%s] %s (Line %d)%s\n",
                strtoupper($issue['severity']),
                $issue['message'],
                $issue['line'],
                isset($issue['standardReference']) ? ' [OWASP ' . $issue['standardReference'] . ']' : ''
            );
        }
        echo PHP_EOL;
    }

    echo "Summary: Scanned {$scannedCount} files, found {$issueCount} potential issues.\n";
}

function runCli(array $argv): int
{
    $path = null;
    $exclude = [];
    $help = false;
    for ($i = 1, $argc = count($argv); $i < $argc; $i++) {
        $argument = $argv[$i];
        if ($argument === '--help') {
            $help = true;
            continue;
        }
        $parts = explode('=', $argument, 2);
        $option = $parts[0];
        $value = $parts[1] ?? null;
        if (substr($argument, 0, 2) === '-p' && strlen($argument) > 2 && $argument[2] !== '=') {
            $option = '-p';
            $value = substr($argument, 2);
        }
        if (!in_array($option, ['-p', '--path', '--exclude'], true)) {
            fwrite(STDERR, "Unknown argument: {$argument}\n");
            return 2;
        }
        if ($value === null && isset($argv[$i + 1]) && substr($argv[$i + 1], 0, 1) !== '-') {
            $value = $argv[++$i];
        }
        if ($value === null || $value === '') {
            fwrite(STDERR, "Missing value for {$option}\n");
            return 2;
        }
        if ($option === '--exclude') {
            $exclude = array_merge($exclude, explode(',', $value));
        } elseif ($path === null) {
            $path = $value;
        } else {
            fwrite(STDERR, "Specify the scan directory only once.\n");
            return 2;
        }
    }
    if ($help) {
        showHelp();
        return 0;
    }
    if ($path === null) {
        fwrite(STDERR, "Missing required --path directory or file.\n");
        return 2;
    }

    try {
        $linter = new Linter();
        $results = $linter->scan($path, $exclude);
        outputResults($results);
        $warnings = $results['_meta']['warnings'] ?? [];
        foreach ($warnings as $warning) {
            fwrite(STDERR, "WARNING: {$warning}\n");
        }
        if ($warnings) {
            return 4;
        }
        return ($results['_meta']['issue_count'] ?? 0) > 0 ? 1 : 0;
    } catch (LinterException $e) {
        fwrite(STDERR, "SCAN ERROR [{$e->getCode()}]: {$e->getMessage()}\n");
        return 2;
    } catch (Throwable $e) {
        fwrite(STDERR, "FATAL ERROR: {$e->getMessage()}\n");
        return 3;
    }
}

if (basename(realpath($_SERVER['SCRIPT_FILENAME'])) === basename(__FILE__)) {
    exit(runCli($argv));
}
