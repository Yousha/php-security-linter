flowchart TD
    Runtime["PHP 8.0+, PCRE, tokenizer"] --> Cli["bin/php-sl"]
    Cli --> Linter["Linter"]
    Cli --> Sarif["SarifFormatter"]
    Cli --> Catalog["RuleCatalog"]
    Linter --> Catalog
    Sarif --> Catalog
    Catalog --> CIS["CisRules"]
